        ],
        "security": [
          {
            "CognitoAuthorizer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "x-amazon-apigateway-integration": {
          "uri": "arn:aws:apigateway:${AWS_REGION}:dynamodb:action/UpdateItem",
          "credentials": "${APIGW_ROLE_ARN}",
          "responses": {
            "default": {
              "statusCode": "200"
            }
          },
          "httpMethod": "POST",
          "type": "aws",
          "requestTemplates": {
            "application/json": "{\n  \"TableName\": \"${RECORDS_TABLE}\",\n  \"Key\": {\n    \"schemaId\": { \"S\": \"$input.params('schemaId')\" },\n    \"id\": { \"S\": \"$input.params('id')\" }\n  },\n  \"UpdateExpression\": \"set #d = :val\",\n  \"ExpressionAttributeNames\": { \"#d\": \"data\" },\n  \"ExpressionAttributeValues\": {\n    \":val\": { \"S\": \"$input.json('$')\" }\n  }\n}\n"
          }
        }
      }
