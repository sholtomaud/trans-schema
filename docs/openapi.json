          "responses": {
            "default": {
              "statusCode": "201"
            }
          },
          "httpMethod": "POST",
          "type": "aws",
          "requestTemplates": {
            "application/json": "{\n  \"TableName\": \"${RECORDS_TABLE}\",\n  \"Item\": {\n    \"schemaId\": { \"S\": \"$input.params('schemaId')\" },\n    \"id\": { \"S\": \"$input.path('$.id')\" },\n    \"data\": { \"S\": \"$input.json('$')\" }\n  }\n}\n"
          }
        }
