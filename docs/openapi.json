          "httpMethod": "POST",
          "type": "aws",
          "requestTemplates": {
            "application/json": "{\n  \"TableName\": \"${RECORDS_TABLE}\",\n  \"FilterExpression\": \"schemaId = :s AND contains(#d, :q)\",\n  \"ExpressionAttributeNames\": { \"#d\": \"data\" },\n  \"ExpressionAttributeValues\": {\n    \":s\": { \"S\": \"$input.path('$.schemaId')\" },\n    \":q\": { \"S\": \"$input.path('$.query')\" }\n  }\n}\n"
          }
