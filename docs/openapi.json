              "statusCode": "201"
            }
          },
          "httpMethod": "POST",
          "type": "aws",
          "requestTemplates": {
            "application/json": "{\n  \"TableName\": \"${SCHEMAS_TABLE}\",\n  \"Item\": {\n    \"schemaId\": { \"S\": \"$input.path('$.schemaId')\" },\n    \"definition\": { \"S\": \"$input.json('$.definition')\" }\n  }\n}\n"
