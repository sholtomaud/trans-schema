{
  "name": "nrds-server",
  "version": "1.0.0",
  "description": "Basic server app using GFC to accompany the NRDS Client app",
  "type": "module",
  "scripts": {
    "test": "npm run test:infra && npm run test:e2e:frontend && npm run test:e2e:api",
    "test:infra": "node --test tests/infra/*.test.ts",
    "test:e2e:api": "node --test tests/e2e/*.test.ts",
    "test:e2e:frontend": "playwright test"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@playwright/test": "^1.40.0",
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^20.0.0",
    "aws-cdk-lib": "^2.260.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
  }
}
